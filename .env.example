# true = pipeline mock (sem GPU), devolve a imagem de entrada com marca "MOCK"
MOCK=true
MOCK_DELAY_S=2

# Modelo real (E3)
MODEL_ID=Qwen/Qwen-Image-Edit-2511
MODEL_REVISION=6f3ccc0b56e431dc6a0c2b2039706d7d26f22cb9
# MODEL_DIR=/workspace/models/Qwen-Image-Edit-2511   # pasta local com o modelo (usada no lugar de MODEL_ID)
PRECISION=auto          # auto | bf16 | fp8 | nf4 -- auto escolhe pela VRAM detectada
CPU_OFFLOAD=auto        # auto | on | off -- só no fp8; auto liga abaixo de 40GB de VRAM
NUM_STEPS=30
GUIDANCE=4.0            # true_cfg_scale do Qwen-Image-Edit (não guidance_scale, fixo em 1.0)
LORA_PATH=
LORA_SCALE=1.0
LIGHTNING_PATH=         # LoRA Lightning (4 ou 8 steps): usar NUM_STEPS=4 ou 8; GUIDANCE ignorado
TRANSFORMER_DIR=        # transformer já fundido (scripts/fuse_transformer.py): sobe mais rápido
MAX_SIDE=1536           # redimensiona entradas maiores que isso (lado maior, px)

# Auth opcional. No Render, use o mesmo valor em CUSTOM_API_KEY
API_KEY=

# Saída
OUTPUT_DIR=outputs
RETURN_MODE=url         # url | base64
# URL pela qual o Render (e quem abrir o resultado) alcança este servidor
PUBLIC_BASE_URL=http://localhost:8000
OUTPUT_SIZE=original    # original = mesmo tamanho da entrada; model = como o Qwen gerou (~1 MP)
UPSCALER=none           # none | realesrgan_x2 | realesrgan_x4 | swinir_x4 (pesos: scripts/download_upscalers.py)
UPSCALER_DIR=upscalers
